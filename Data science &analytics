import pandas as pd
import matplotlib.pyplot as plt

# Task 1: Sales Dashboard Analysis
# Author: Justin Raj

# Load Dataset
df = pd.read_csv('sales_data.csv')
df['Date'] = pd.to_datetime(df['Date'])

# KPI Analysis
total_revenue = df['Revenue'].sum()
print(f"Total Revenue: {total_revenue}")

# Visualization 1: Monthly Revenue Trend
monthly_revenue = df.groupby(df['Date'].dt.to_period('M'))['Revenue'].sum()
monthly_revenue.plot(kind='line', marker='o', figsize=(10,5))
plt.title('Monthly Revenue Trend', fontsize=14, fontweight='bold')
plt.ylabel('Revenue')
plt.grid(True)
plt.savefig('dashboard_monthly.png')
plt.show()

# Visualization 2: Top 5 Products
top_products = df.groupby('Product')['Revenue'].sum().sort_values(ascending=False).head(5)
top_products.plot(kind='bar', figsize=(8,5), color='skyblue')
plt.title('Top 5 Products by Revenue')
plt.savefig('dashboard_products.png')
plt.show()

# Visualization 3: Region Performance
region_perf = df.groupby('Region')['Revenue'].sum()
region_perf.plot(kind='pie', autopct='%1.1f%%', figsize=(7,7))
plt.title('Region Performance')
plt.ylabel('')
plt.savefig('dashboard_region.png')
plt.show()
